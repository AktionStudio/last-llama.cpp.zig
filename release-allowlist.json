{
  "release_boundary": "release-allowlist-v1",
  "path": "repository root",
  "allowlist": [
    "README.md",
    "last-llama.json.example",
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "DEPENDENCIES.md",
    "EXTRACTION_MANIFEST.md",
    "build.zig",
    "build.zig.zon",
    ".gitignore",
    "src/",
    "tests/",
    "fixtures/",
    "examples/",
    "models/README.md",
    "scripts/build-default.json",
    "scripts/build-engine.ps1",
    "scripts/build-schema-api.ps1",
    "scripts/finalize-release.ps1",
    "scripts/generate-bindings.ps1",
    "scripts/prepare-release.ps1",
    "scripts/run-gate.ps1",
    "scripts/setup-dependencies.ps1",
    "scripts/test-cli.ps1",
    "scripts/verify-gate.py",
    "docs/ (excluding historical baseline and migration-only material)",
    "docs/owned-interface/PROVENANCE.md"
  ],
  "omit": [
    "external/",
    "models/* except models/README.md",
    "build/",
    ".tools/",
    ".zig-cache/",
    "results/",
    "evidence/",
    "temp/",
    "release/",
    "docs/owned-interface/baseline/",
    "docs/owned-interface/README.md",
    "docs/owned-interface/REQUIREMENTS.md",
    "docs/owned-interface/capture-supplemental.py",
    "scripts/qualify-build-host.ps1",
    "scripts/verify-frozen-parity.py",
    "scripts/verify-token-pieces.py"
  ]
}
